APP_NAME="Yeboox SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_RUNTIME_MODE=cloud

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yeboox_saas
DB_USERNAME=yeboox_app
DB_PASSWORD=
DB_SSLMODE=require

# Copie SQLite facultative utilisée uniquement par les outils de migration.
OFFLINE_DB_DATABASE=database/database.sqlite

OFFLINE_SYNC_ENABLED=false
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
SANCTUM_MOBILE_EXPIRATION=43200
