{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sogeref-erp",
    "private": true,
    "version": "1.0.0",
    "description": "SOGEREF ERP — ventes, atelier, chantiers, stock, finance, RH & paie (Web + Desktop)",
    "author": "SOGEREF Sarl",
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "desktop": "concurrently -k \"vite\" \"electron .\"",
        "desktop:build": "npm run build && electron-builder",
        "desktop:build:windows": "npm run build && electron-builder --win nsis --x64"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/saira": "^5.3.0",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.16.2",
        "chart.js": "^4.5.1",
        "concurrently": "^10.0.5",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^3.1",
        "sortablejs": "^1.15.7",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "wait-on": "^9.1.0"
    },
    "build": {
        "appId": "cd.sogeref.erp",
        "productName": "SOGEREF ERP",
        "artifactName": "SOGEREF-ERP-${version}-${arch}-Setup.${ext}",
        "copyright": "Copyright © 2026 SOGEREF Sarl",
        "asar": true,
        "compression": "maximum",
        "directories": {
            "output": "release",
            "buildResources": "electron/installer"
        },
        "files": [
            "electron/**/*",
            "!electron/runtime/**/*",
            "!electron/prerequisites/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": ".",
                "to": "app",
                "filter": [
                    "app/**/*",
                    "bootstrap/**/*",
                    "config/**/*",
                    "database/**/*",
                    "!database/database.sqlite",
                    "!database/*.sqlite*",
                    "public/**/*",
                    "resources/views/**/*",
                    "routes/**/*",
                    "vendor/**/*",
                    "artisan",
                    "composer.json"
                ]
            },
            {
                "from": "electron/runtime/php-win-x64",
                "to": "php"
            },
            {
                "from": "electron/prerequisites",
                "to": "prerequisites"
            }
        ],
        "mac": {
            "icon": "electron/icons/icon.icns",
            "target": "dmg",
            "category": "public.app-category.finance"
        },
        "win": {
            "icon": "electron/icons/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "legalTrademarks": "SOGEREF ERP — SOGEREF Sarl",
            "requestedExecutionLevel": "asInvoker",
            "signExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "shortcutName": "SOGEREF ERP",
            "uninstallDisplayName": "SOGEREF ERP",
            "menuCategory": "SOGEREF",
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "installerIcon": "electron/icons/icon.ico",
            "uninstallerIcon": "electron/icons/icon.ico",
            "installerHeaderIcon": "electron/icons/icon.ico",
            "installerSidebar": "electron/installer/sidebar.bmp",
            "installerHeader": "electron/installer/header.bmp",
            "license": "electron/eula/license_fr.txt",
            "include": "electron/installer/custom.nsh",
            "installerLanguages": [
                "fr_FR"
            ],
            "displayLanguageSelector": false
        }
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "intl-tel-input": "^29.2.0",
        "quill": "2.0.2"
    }
}
